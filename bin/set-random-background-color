#!/bin/bash
# Sets iTerm2 background to a random dark color
# 256 dark color options: 8 levels R × 8 levels G × 4 levels B

VERSION="1.1.0"
SCRIPT_NAME=$(basename "$0")

if [ "$1" = "-v" ] || [ "$1" = "--version" ]; then
  echo "$SCRIPT_NAME $VERSION"
  exit 0
fi

if [ "$1" = "-h" ] || [ "$1" = "--help" ]; then
  echo "Usage: $SCRIPT_NAME [options]"
  echo ""
  echo "Sets iTerm2 background to a random dark color."
  echo ""
  echo "Options:"
  echo "  -n, --dry-run    Show the color that would be set without applying"
  echo "  -v, --version    Show version"
  echo "  -h, --help       Show this help"
  exit 0
fi

DRY_RUN=0
if [ "$1" = "-n" ] || [ "$1" = "--dry-run" ]; then
  DRY_RUN=1
fi

# Dark color levels (0-77 range keeps it dark)
r_levels=(0 11 22 33 44 55 66 77)
g_levels=(0 11 22 33 44 55 66 77)
b_levels=(0 25 50 75)

# Pick random indices
r=${r_levels[$((RANDOM % 8))]}
g=${g_levels[$((RANDOM % 8))]}
b=${b_levels[$((RANDOM % 4))]}

# Format as hex
hex=$(printf "%02x%02x%02x" "$r" "$g" "$b")

if [ "$DRY_RUN" = "1" ]; then
  echo "Would set background color to: #$hex (RGB: $r, $g, $b)"
else
  # Set iTerm2 background color
  printf "\033]1337;SetColors=bg=%s\007" "$hex"
fi
