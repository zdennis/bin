#!/bin/bash
#
# zdennis-bin-all - List all zdennis/bin tools available via Homebrew
#
# Usage: zdennis-bin-all [--version]
#
# This is a meta-package that installs all zdennis/bin tools.
# Run this command to see what's included.

VERSION="1.26.5"

if [[ "$1" == "--version" || "$1" == "-v" ]]; then
  echo "zdennis-bin-all $VERSION"
  exit 0
fi

if [[ "$1" == "--help" || "$1" == "-h" ]]; then
  echo "Usage: zdennis-bin-all [options]"
  echo ""
  echo "Lists all zdennis/bin tools available via Homebrew."
  echo ""
  echo "Options:"
  echo "  -v, --version    Show version"
  echo "  -h, --help       Show this help"
  exit 0
fi

echo "zdennis/bin tools v$VERSION (installed via 'brew install zdennis/bin/zdennis-bin-all'):"
echo ""
echo "  alias-directory (1.0.0)           - Manage directory aliases for quick cd navigation"
echo "  ascii-banner (1.3.0)              - Create ASCII art banners with color, sizing, and alignment options"
echo "  code+x (1.0.0)                    - Create executable files and open them in VS Code"
echo "  codep (1.0.0)                     - Touch files with parent directories and open them in VS Code"
echo "  html-viewer (0.9.0)               - Always-on-top macOS window for viewing HTML files and URLs from the CLI"
echo "  queue-commands (1.0.0)            - Run commands from a file sequentially, pausing on errors"
echo "  retry-command (1.0.1)             - Retry commands with configurable delay, limits, and supervisor mode"
echo "  run-through (1.1.0)               - Run files through multiple shell commands"
echo "  set-random-background-color (1.0.0) - Set iTerm2 background to a random dark color"
echo "  touchp (1.0.0)                    - Touch a file and create parent directories in its path"
echo "  window-tool (0.17.0)              - Fast macOS CLI for listing, moving, and resizing application windows"
echo "  workspace (0.16.0)                - Manage tmuxinator-based development workspaces in iTerm2"
echo ""
echo "Note: Versions shown are what this formula installs. If you installed tools"
echo "separately, you may have different versions. Use '<tool> --version' to check."
echo ""
echo "For help on any tool, run: <tool-name> --help"
