#!/usr/bin/env ruby
# frozen_string_literal: true

#
# Converts text to blocky ASCII art with color and alignment options.
#
# Usage: ascii-textify [OPTIONS] TEXT
#
# Examples:
#   ascii-textify "Hello"
#   ascii-textify --color red "Error"
#   ascii-textify --rainbow "Success"
#   ascii-textify --rainbow --color cyan "Tinted"  # Tinted rainbow
#   ascii-textify --center --width 80 "Centered"
#   ascii-textify --watch --center "Hello"     # Re-renders on terminal resize
#   ascii-textify --list-colors
#

require "optparse"
require "io/console"

