  # Rainbow colors in order
  RAINBOW_COLORS = [196, 202, 208, 214, 220, 226, 190, 154, 118, 82, 46, 47, 48, 49, 50, 51, 45, 39, 33, 27, 21, 57, 93, 129, 165, 201].freeze

  def initialize(argv)
    @argv = argv
    @options = {
      width: terminal_width,
      height: nil,
      align: :left,
      color: nil,
      rainbow: false,
      list_colors: false,
      watch: false
    }
  end

  def run
    parse_options!

    if @options[:list_colors]
      list_colors
      return
    end

    if @text.nil? || @text.empty?
      warn "Error: No text provided"
      warn "Usage: ascii-textify [OPTIONS] TEXT"
      exit 1
    end

    if @options[:watch]
      watch_loop
    else
      output = render_text(@text)
      puts output
    end
  end

  private

  def terminal_width
    IO.console&.winsize&.last || 80
  end

  def watch_loop
    @needs_redraw = true

    Signal.trap("WINCH") do
      @needs_redraw = true
    end

    Signal.trap("INT") do
      clear_screen
      exit 0
    end

    loop do
      if @needs_redraw
        @needs_redraw = false
        @options[:width] = terminal_width
        clear_screen
        output = render_text(@text)
        puts output
      end
      sleep 0.1
    end
  end

  def clear_screen
    print "\e[2J\e[H"
  end

  def parse_options!
    parser = OptionParser.new do |opts|
      opts.banner = "Usage: ascii-textify [OPTIONS] TEXT"
      opts.separator ""
      opts.separator "Options:"

      opts.on("-w", "--width WIDTH", Integer, "Maximum width (default: terminal width)") do |w|
        @options[:width] = w
      end

      opts.on("--height HEIGHT", Integer, "Maximum height (scales font if needed)") do |h|
        @options[:height] = h
      end

      opts.on("--left", "Left-align text (default)") do
        @options[:align] = :left
      end

      opts.on("--center", "Center-align text") do
        @options[:align] = :center
      end

      opts.on("--right", "Right-align text") do
        @options[:align] = :right
      end

      opts.on("-c", "--color COLOR", "Color name (use --list-colors to see available)") do |c|
        @options[:color] = c.downcase.gsub(/[\s-]/, "_")
      end

      opts.on("--rainbow", "Apply rainbow effect to text") do
        @options[:rainbow] = true
      end

      opts.on("--list-colors", "List all available color names") do
        @options[:list_colors] = true
      end

      opts.on("-W", "--watch", "Stay running and re-render on terminal resize") do
        @options[:watch] = true
      end

      opts.on("-v", "--version", "Show version") do
        puts "ascii-textify #{VERSION}"
        exit 0
      end

      opts.on("-h", "--help", "Show this help") do
        puts opts
        exit 0
      end
    end

    parser.parse!(@argv)
    @text = @argv.join(" ")
  rescue OptionParser::InvalidOption => e
    warn "Error: #{e.message}"
    warn "Use --help for usage information"
    exit 1
  end

  def list_colors
    puts "Available colors (#{COLORS_256.size} colors):"
    puts ""

    # Group colors by category
    basic = COLORS_256.select { |_, v| v <= 7 }
    bright = COLORS_256.select { |_, v| v >= 8 && v <= 15 }
    extended = COLORS_256.select { |_, v| v >= 16 && v <= 231 }
    grayscale = COLORS_256.select { |_, v| v >= 232 }

    puts "Basic colors (0-7):"
    print_color_group(basic)
    puts ""

    puts "Bright colors (8-15):"
    print_color_group(bright)
    puts ""

    puts "Extended colors (16-231):"
    print_color_group(extended, columns: 4)
    puts ""

    puts "Grayscale (232-255):"
    print_color_group(grayscale, columns: 4)
    puts ""

    puts "Usage: ascii-textify --color <color_name> \"TEXT\""
    puts "Example: ascii-textify --color coral \"Hello\""
  end

  def print_color_group(colors, columns: 3)
    sorted = colors.sort_by { |_, v| v }
    col_width = 25

    sorted.each_slice(columns) do |row|
      line = row.map do |name, code|
        colored = colorize_text("██", code)
        "#{colored} #{name.ljust(20)}(#{code.to_s.rjust(3)})"
      end
      puts "  #{line.join("  ")}"
    end
  end

  def render_text(text)
    # Convert to uppercase for the font
    text = text.upcase

    # Generate ASCII art rows
    rows = text_to_ascii_art(text)
    art_width = rows.first&.length || 0

    # Truncate if wider than max width
    if art_width > @options[:width]
      avg_char_width = 6
      max_chars = (@options[:width] / avg_char_width) - 1
      text = text[0...max_chars]
      rows = text_to_ascii_art(text)
      art_width = rows.first&.length || 0
    end

    # Apply height scaling if specified and needed
    if @options[:height] && @options[:height] < FONT_HEIGHT
      rows = scale_height(rows, @options[:height])
    end

    # Apply alignment
    rows = align_rows(rows, art_width)

    # Apply color
    if @options[:rainbow]
      rows = apply_rainbow(rows, @options[:color])
    elsif @options[:color]
      rows = apply_color(rows, @options[:color])
    end

    rows.join("\n")
  end

  def text_to_ascii_art(text)
    rows = Array.new(FONT_HEIGHT) { +"" }

    text.each_char do |char|
      pattern = ASCII_FONT[char] || ASCII_FONT[" "]
      pattern.each_with_index do |row, i|
        rows[i] << row << " "
      end
    end

    rows.map(&:rstrip)
  end

  def scale_height(rows, target_height)
    return rows if target_height >= rows.length

    # Simple scaling: pick evenly spaced rows
    step = rows.length.to_f / target_height
    (0...target_height).map { |i| rows[(i * step).floor] }
  end

  def align_rows(rows, art_width)
    width = @options[:width]

    case @options[:align]
    when :center
      padding = [(width - art_width) / 2, 0].max
      rows.map { |row| (" " * padding) + row }
    when :right
      padding = [width - art_width, 0].max
      rows.map { |row| (" " * padding) + row }
    else # :left
      rows
    end
  end

  def apply_color(rows, color_name)
    code = COLORS_256[color_name]
    unless code
      warn "Warning: Unknown color '#{color_name}'. Use --list-colors to see available colors."
      return rows
    end

    rows.map { |row| colorize_text(row, code) }
  end

  def apply_rainbow(rows, tint_color_name = nil)
    tint_code = tint_color_name ? COLORS_256[tint_color_name] : nil

    if tint_code && !COLORS_256[tint_color_name]
      warn "Warning: Unknown color '#{tint_color_name}'. Using untinted rainbow."
      tint_code = nil
    end

    # Apply rainbow colors column by column
    rows.map do |row|
      colored_chars = row.chars.map.with_index do |char, i|
        if char == " "
          char
        else
          color_index = i % RAINBOW_COLORS.length
          rainbow_code = RAINBOW_COLORS[color_index]
          final_code = tint_code ? blend_colors(rainbow_code, tint_code, 0.4) : rainbow_code
          colorize_text(char, final_code)
        end
      end
      colored_chars.join
    end
  end

  def colorize_text(text, color_code)
    "\e[38;5;#{color_code}m#{text}\e[0m"
  end

  # Convert 256 color code to RGB
  def color_code_to_rgb(code)
    if code < 16
      # Standard colors
      [
        [0, 0, 0], [128, 0, 0], [0, 128, 0], [128, 128, 0],
        [0, 0, 128], [128, 0, 128], [0, 128, 128], [192, 192, 192],
        [128, 128, 128], [255, 0, 0], [0, 255, 0], [255, 255, 0],
        [0, 0, 255], [255, 0, 255], [0, 255, 255], [255, 255, 255]
      ][code]
    elsif code < 232
      # 6x6x6 color cube
      code -= 16
      levels = [0, 95, 135, 175, 215, 255]
      [levels[code / 36], levels[(code % 36) / 6], levels[code % 6]]
    else
      # Grayscale
      gray = 8 + (code - 232) * 10
      [gray, gray, gray]
    end
  end

  # Convert RGB to nearest 256 color code
  def rgb_to_color_code(r, g, b)
    levels = [0, 95, 135, 175, 215, 255]
    r_idx = levels.each_with_index.min_by { |l, _| (l - r).abs }[1]
    g_idx = levels.each_with_index.min_by { |l, _| (l - g).abs }[1]
    b_idx = levels.each_with_index.min_by { |l, _| (l - b).abs }[1]
    16 + (r_idx * 36) + (g_idx * 6) + b_idx
  end

  # Blend two colors together (factor 0.0 = all color1, 1.0 = all color2)
  def blend_colors(color1_code, color2_code, factor = 0.5)
    rgb1 = color_code_to_rgb(color1_code)
    rgb2 = color_code_to_rgb(color2_code)
    blended = rgb1.zip(rgb2).map { |c1, c2| (c1 * (1 - factor) + c2 * factor).round }
    rgb_to_color_code(*blended)
  end
end

AsciiTextify.new(ARGV).run
