  # Rainbow colors in order
  RAINBOW_COLORS = [196, 202, 208, 214, 220, 226, 190, 154, 118, 82, 46, 47, 48, 49, 50, 51, 45, 39, 33, 27, 21, 57, 93, 129, 165, 201].freeze

  # Size presets: name => [vertical_scale, horizontal_scale]
  SIZE_SCALES = {
    "tiny"   => [0.5, 0.5],
    "small"  => [0.67, 0.67],
    "medium" => [1, 1],
    "large"  => [2, 2],
    "xlarge" => [3, 3]
  }.freeze

  # Order for rotating through sizes
  ROTATION_SIZES = %w[tiny small medium large xlarge].freeze

  def initialize(argv)
    @argv = argv
    @options = {
      width: terminal_width,
      height: nil,
      align: :left,
      color: nil,
      rainbow: false,
      random_color: false,
      list_colors: false,
      watch: false,
      margin: { top: 2, bottom: 2, left: 2, right: 2 },
      size: "medium",
      auto_scale: false
    }
  end

  def run
    parse_options!

    if @options[:list_colors]
      list_colors
      return
    end

    if @text.nil? || @text.empty?
      warn "Error: No text provided"
      warn "Usage: ascii-banner [OPTIONS] TEXT"
      exit 1
    end

    if @options[:size] == "rotate"
      rotate_loop
    elsif @options[:watch]
      watch_loop
    else
      output = render_text(@text)
      puts output
    end
  end

  private

  def terminal_width
    IO.console&.winsize&.last || 80
  end

  def terminal_height
    IO.console&.winsize&.first || 24
  end

  def watch_loop
    @needs_redraw = true

    console = IO.console
    unless console
      warn "Error: Watch mode requires a terminal"
      exit 1
    end

    Signal.trap("WINCH") do
      @needs_redraw = true
    end

    Signal.trap("INT") do
      reset_terminal
      exit 0
    end

    print "\e[?25l" # Hide cursor
    console.raw do
      loop do
        if @needs_redraw
          @needs_redraw = false
          @options[:width] = terminal_width
          clear_screen
          output = render_text(@text)
          # In raw mode, \n doesn't include carriage return
          print output.gsub("\n", "\r\n") + "\r\n"
          output_lines = output.count("\n") + 1
          print "\e[#{output_lines + 2};1H\e[2mPress any key to refresh, 'q' to quit\e[0m"
        end

        # Check for keypress with timeout
        if IO.select([STDIN], nil, nil, 0.1)
          key = STDIN.read_nonblock(1) rescue nil
          if key == "q" || key == "\x03" # q or Ctrl-C
            reset_terminal
            exit 0
          elsif key
            @needs_redraw = true
          end
        end
      end
    end
  end

  def rotate_loop
    console = IO.console
    unless console
      warn "Error: Rotate mode requires a terminal"
      exit 1
    end

    Signal.trap("INT") do
      reset_terminal
      exit 0
    end

    size_index = 0
    print "\e[?25l" # Hide cursor

    console.raw do
      loop do
        @options[:size] = ROTATION_SIZES[size_index]
        @options[:width] = terminal_width
        clear_screen
        output = render_text(@text)
        print output.gsub("\n", "\r\n") + "\r\n"
        output_lines = output.count("\n") + 1
        print "\e[#{output_lines + 2};1H\e[2mSize: #{@options[:size]} | 'q' to quit\e[0m"

        # Wait 1.5 seconds, checking for quit
        15.times do
          if IO.select([STDIN], nil, nil, 0.1)
            key = STDIN.read_nonblock(1) rescue nil
            if key == "q" || key == "\x03"
              reset_terminal
              exit 0
            end
          end
        end

        size_index = (size_index + 1) % ROTATION_SIZES.length
      end
    end
  end

  def reset_terminal
    clear_screen
    print "\e[?25h" # Show cursor
  end

  def clear_screen
    print "\e[2J\e[H"
  end

  def parse_options!
    parser = OptionParser.new do |opts|
      opts.banner = "Usage: ascii-banner [OPTIONS] TEXT"
      opts.separator ""
      opts.separator "Options:"

      opts.on("-w", "--width WIDTH", Integer, "Maximum width (default: terminal width)") do |w|
        @options[:width] = w
      end

      opts.on("--height HEIGHT", Integer, "Maximum height (scales font if needed)") do |h|
        @options[:height] = h
      end

      opts.on("--left", "Left-align text (default)") do
        @options[:align] = :left
      end

      opts.on("--center", "Center horizontally and vertically (disables margin)") do
        @options[:align] = :center
      end

      opts.on("--right", "Right-align text") do
        @options[:align] = :right
      end

      opts.on("-c", "--color COLOR", "Color name (use --list-colors to see available)") do |c|
        @options[:color] = c.downcase.gsub(/[\s-]/, "_")
      end

      opts.on("--rainbow", "Apply rainbow effect to text") do
        @options[:rainbow] = true
      end

      opts.on("--random", "Pick a random color (works with --rainbow for tinting)") do
        @options[:random_color] = true
      end

      opts.on("--list-colors", "List all available color names") do
        @options[:list_colors] = true
      end

      opts.on("-W", "--watch", "Stay running, re-render on resize or keypress") do
        @options[:watch] = true
      end

      opts.on("-m", "--margin [MARGIN]", "Set margin: N, ROW,COL, or TOP,BOT,LEFT,RIGHT (default: 2)") do |m|
        @options[:margin] = parse_margin(m)
      end

      opts.on("--no-margin", "Disable margin (same as --margin=0)") do
        @options[:margin] = { top: 0, bottom: 0, left: 0, right: 0 }
      end

      opts.on("-s", "--size SIZE", SIZE_SCALES.keys + ["rotate"], "Font size: tiny, small, medium, large, xlarge, rotate (default: medium)") do |s|
        @options[:size] = s
      end

      opts.on("--auto-scale", "Auto-select best size to fit terminal") do
        @options[:auto_scale] = true
      end

      opts.on("-v", "--version", "Show version") do
        puts "ascii-banner #{VERSION}"
        exit 0
      end

      opts.on("-h", "--help", "Show this help") do
        puts opts
        exit 0
      end
    end

    parser.parse!(@argv)
    @text = @argv.join(" ")
  end

  def parse_margin(value)
    return { top: 2, bottom: 2, left: 2, right: 2 } if value.nil? || value.empty?

    # If value doesn't look like a margin spec (digits and commas), it's banner text
    unless value.match?(/\A\d+(,\d+)*\z/)
      @argv.unshift(value)
      return { top: 2, bottom: 2, left: 2, right: 2 }
    end

    parts = value.split(",").map(&:to_i)
    case parts.length
    when 1
      { top: parts[0], bottom: parts[0], left: parts[0], right: parts[0] }
    when 2
      { top: parts[0], bottom: parts[0], left: parts[1], right: parts[1] }
    when 4
      { top: parts[0], bottom: parts[1], left: parts[2], right: parts[3] }
    else
      warn "Warning: Invalid margin format '#{value}'. Using default."
      { top: 2, bottom: 2, left: 2, right: 2 }
    end
  rescue OptionParser::InvalidOption => e
    warn "Error: #{e.message}"
    warn "Use --help for usage information"
    exit 1
  end

  def list_colors
    puts "Available colors (#{COLORS_256.size} colors):"
    puts ""

    # Group colors by category
    basic = COLORS_256.select { |_, v| v <= 7 }
    bright = COLORS_256.select { |_, v| v >= 8 && v <= 15 }
    extended = COLORS_256.select { |_, v| v >= 16 && v <= 231 }
    grayscale = COLORS_256.select { |_, v| v >= 232 }

    puts "Basic colors (0-7):"
    print_color_group(basic)
    puts ""

    puts "Bright colors (8-15):"
    print_color_group(bright)
    puts ""

    puts "Extended colors (16-231):"
    print_color_group(extended, columns: 4)
    puts ""

    puts "Grayscale (232-255):"
    print_color_group(grayscale, columns: 4)
    puts ""

    puts "Usage: ascii-banner --color <color_name> \"TEXT\""
    puts "Example: ascii-banner --color coral \"Hello\""
  end

  def print_color_group(colors, columns: 3)
    sorted = colors.sort_by { |_, v| v }
    col_width = 25

    sorted.each_slice(columns) do |row|
      line = row.map do |name, code|
        colored = colorize_text("██", code)
        "#{colored} #{name.ljust(20)}(#{code.to_s.rjust(3)})"
      end
      puts "  #{line.join("  ")}"
    end
  end

  def render_text(text)
    # Pick a random color if requested
    if @options[:random_color]
      @options[:color] = COLORS_256.keys.sample
    end

    # Auto-scale: find best size for terminal
    if @options[:auto_scale]
      @options[:size] = calculate_best_size(text)
    end

    # Convert to uppercase for the font
    text = text.upcase

    # Select font based on size
    font, font_height = select_font

    # Generate ASCII art rows
    rows = text_to_ascii_art(text, font, font_height)
    art_width = rows.first&.length || 0

    # Truncate if wider than max width
    if art_width > @options[:width]
      avg_char_width = 6
      max_chars = (@options[:width] / avg_char_width) - 1
      text = text[0...max_chars]
      rows = text_to_ascii_art(text, font, font_height)
      art_width = rows.first&.length || 0
    end

    # Apply height scaling if specified and needed
    if @options[:height] && @options[:height] < font_height
      rows = scale_height(rows, @options[:height])
    end

    # Apply size scaling (only for large/xlarge which scale up)
    if @options[:size] == "large" || @options[:size] == "xlarge"
      rows = scale_size(rows)
      art_width = rows.first&.length || 0  # Recalculate after scaling
    end

    # Apply alignment
    rows = align_rows(rows, art_width)

    # Apply color
    if @options[:rainbow]
      rows = apply_rainbow(rows, @options[:color])
    elsif @options[:color]
      rows = apply_color(rows, @options[:color])
    end

    # Apply margin (skip when centering - centering uses full terminal width)
    if @options[:margin] && @options[:align] != :center
      rows = apply_margin(rows)
    end

    rows.join("\n")
  end

  def select_font
    case @options[:size]
    when "tiny"
      [TINY_FONT, TINY_FONT_HEIGHT]
    when "small"
      [SMALL_FONT, SMALL_FONT_HEIGHT]
    else
      [ASCII_FONT, FONT_HEIGHT]
    end
  end

  def calculate_best_size(text)
    term_height = terminal_height
    term_width = terminal_width

    # Calculate margin overhead (if not centering)
    margin_v = 0
    margin_h = 0
    if @options[:align] != :center && @options[:margin]
      margin_v = @options[:margin][:top] + @options[:margin][:bottom]
      margin_h = @options[:margin][:left] + @options[:margin][:right]
    end

    available_height = term_height - margin_v - 1  # -1 for prompt
    available_width = term_width - margin_h

    # Height for each size: tiny=3, small=4, medium=6, large=12, xlarge=18
    size_heights = {
      "xlarge" => 18,
      "large"  => 12,
      "medium" => 6,
      "small"  => 4,
      "tiny"   => 3
    }

    # Approximate width per character for each size
    size_char_widths = {
      "xlarge" => 18,  # 6 * 3
      "large"  => 12,  # 6 * 2
      "medium" => 6,
      "small"  => 5,
      "tiny"   => 4
    }

    text_len = text.length

    # Find largest size that fits both height and width
    %w[xlarge large medium small tiny].each do |size|
      height = size_heights[size]
      width = text_len * size_char_widths[size]

      if height <= available_height && width <= available_width
        return size
      end
    end

    "tiny"  # Fallback to smallest
  end

  def text_to_ascii_art(text, font = ASCII_FONT, font_height = FONT_HEIGHT)
    rows = Array.new(font_height) { +"" }

    text.each_char do |char|
      pattern = font[char] || font[" "]
      pattern.each_with_index do |row, i|
        rows[i] << row << " "
      end
    end

    rows.map(&:rstrip)
  end

  def scale_height(rows, target_height)
    return rows if target_height >= rows.length

    # Simple scaling: pick evenly spaced rows
    step = rows.length.to_f / target_height
    (0...target_height).map { |i| rows[(i * step).floor] }
  end

  def scale_size(rows)
    # Only used for scaling UP (large/xlarge)
    v_scale, h_scale = SIZE_SCALES[@options[:size]]

    # Scale horizontally: duplicate each character
    if h_scale > 1
      rows = rows.map do |row|
        row.chars.map { |c| c * h_scale.to_i }.join
      end
    end

    # Scale vertically: duplicate each row
    if v_scale > 1
      rows = rows.flat_map { |row| [row] * v_scale.to_i }
    end

    rows
  end

  def align_rows(rows, art_width)
    width = @options[:width]

    case @options[:align]
    when :center
      # Horizontal centering
      h_padding = [(width - art_width) / 2, 0].max
      rows = rows.map { |row| (" " * h_padding) + row }

      # Vertical centering
      v_padding = [(terminal_height - rows.length) / 2, 0].max
      top_rows = Array.new(v_padding, "")
      bottom_rows = Array.new(v_padding, "")
      top_rows + rows + bottom_rows
    when :right
      padding = [width - art_width, 0].max
      rows.map { |row| (" " * padding) + row }
    else # :left
      rows
    end
  end

  def apply_color(rows, color_name)
    code = COLORS_256[color_name]
    unless code
      warn "Warning: Unknown color '#{color_name}'. Use --list-colors to see available colors."
      return rows
    end

    rows.map { |row| colorize_text(row, code) }
  end

  def apply_rainbow(rows, tint_color_name = nil)
    tint_code = tint_color_name ? COLORS_256[tint_color_name] : nil

    if tint_code && !COLORS_256[tint_color_name]
      warn "Warning: Unknown color '#{tint_color_name}'. Using untinted rainbow."
      tint_code = nil
    end

    # Apply rainbow colors column by column
    rows.map do |row|
      colored_chars = row.chars.map.with_index do |char, i|
        if char == " "
          char
        else
          color_index = i % RAINBOW_COLORS.length
          rainbow_code = RAINBOW_COLORS[color_index]
          final_code = tint_code ? blend_colors(rainbow_code, tint_code, 0.4) : rainbow_code
          colorize_text(char, final_code)
        end
      end
      colored_chars.join
    end
  end

  def apply_margin(rows)
    margin = @options[:margin]
    left_padding = " " * margin[:left]

    # Add left margin to each row
    rows = rows.map { |row| left_padding + row }

    # Add top margin (empty lines)
    top_rows = Array.new(margin[:top], "")

    # Add bottom margin (empty lines)
    bottom_rows = Array.new(margin[:bottom], "")

    top_rows + rows + bottom_rows
  end

  def colorize_text(text, color_code)
    "\e[38;5;#{color_code}m#{text}\e[0m"
  end

  # Convert 256 color code to RGB
  def color_code_to_rgb(code)
    if code < 16
      # Standard colors
      [
        [0, 0, 0], [128, 0, 0], [0, 128, 0], [128, 128, 0],
        [0, 0, 128], [128, 0, 128], [0, 128, 128], [192, 192, 192],
        [128, 128, 128], [255, 0, 0], [0, 255, 0], [255, 255, 0],
        [0, 0, 255], [255, 0, 255], [0, 255, 255], [255, 255, 255]
      ][code]
    elsif code < 232
      # 6x6x6 color cube
      code -= 16
      levels = [0, 95, 135, 175, 215, 255]
      [levels[code / 36], levels[(code % 36) / 6], levels[code % 6]]
    else
      # Grayscale
      gray = 8 + (code - 232) * 10
      [gray, gray, gray]
    end
  end

  # Convert RGB to nearest 256 color code
  def rgb_to_color_code(r, g, b)
    levels = [0, 95, 135, 175, 215, 255]
    r_idx = levels.each_with_index.min_by { |l, _| (l - r).abs }[1]
    g_idx = levels.each_with_index.min_by { |l, _| (l - g).abs }[1]
    b_idx = levels.each_with_index.min_by { |l, _| (l - b).abs }[1]
    16 + (r_idx * 36) + (g_idx * 6) + b_idx
  end

  # Blend two colors together (factor 0.0 = all color1, 1.0 = all color2)
  def blend_colors(color1_code, color2_code, factor = 0.5)
    rgb1 = color_code_to_rgb(color1_code)
    rgb2 = color_code_to_rgb(color2_code)
    blended = rgb1.zip(rgb2).map { |c1, c2| (c1 * (1 - factor) + c2 * factor).round }
    rgb_to_color_code(*blended)
  end
end

AsciiBanner.new(ARGV).run
