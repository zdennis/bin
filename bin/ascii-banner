#!/usr/bin/env ruby
# frozen_string_literal: true

#
# Creates ASCII art banners from text with color and alignment options.
#
# Usage: ascii-banner [OPTIONS] TEXT
#
# Examples:
#   ascii-banner "Hello"
#   ascii-banner --color red "Error"
#   ascii-banner --rainbow "Success"
#   ascii-banner --rainbow --color cyan "Tinted"  # Tinted rainbow
#   ascii-banner --random "Surprise"              # Random color
#   ascii-banner --random --rainbow "Random Tint" # Rainbow with random tint
#   ascii-banner --center "Centered"             # Center horizontally and vertically
#   ascii-banner --watch --center "Hello"     # Re-renders on terminal resize
#   ascii-banner --list-colors
#   ascii-banner "Hello"                      # Includes default 2 row/column margin
#   ascii-banner --no-margin "Hello"          # No margin
#   ascii-banner --margin=4 "Hello"           # 4 row/column margin
#   ascii-banner --margin 4,3 "Hello"         # 4 row, 3 column margin
#   ascii-banner --margin 4,2,1,3 "Hello"     # top, bottom, left, right margin
#   ascii-banner --size large "Hello"         # Large (2x) font
#   ascii-banner --size tiny "Hello"          # Tiny (0.5x) font
#   ascii-banner -s xlarge "Hello"            # Extra large (3x) font
#   ascii-banner --size rotate "Hello"        # Rotate through sizes every 1.5s
#   ascii-banner --auto-scale "Hello"         # Auto-select best size for terminal
#

