#!/usr/bin/env bash

VERSION="1.1.0"
SCRIPT_NAME=$(basename "$0")

if [[ "$1" == "-v" || "$1" == "--version" ]]; then
  echo "$SCRIPT_NAME $VERSION"
  exit 0
fi

if [[ "$1" == "-h" || "$1" == "--help" ]]; then
  echo "Usage: $SCRIPT_NAME [options] <file>..."
  echo ""
  echo "Create file(s) with parent directories and open in VS Code."
  echo "(Unlike code+x, this does not make files executable)"
  echo ""
  echo "Options:"
  echo "  --no-edit     Create file(s) but don't open in VS Code"
  echo "  -v, --version Show version"
  echo "  -h, --help    Show this help"
  exit 0
fi

NO_EDIT=0
if [[ "$1" == "--no-edit" ]]; then
  NO_EDIT=1
  shift
fi

if [[ $# -eq 0 ]]; then
  echo "Error: No files specified" >&2
  exit 1
fi

touchp "$@" || exit 1

if [[ $NO_EDIT -eq 0 ]]; then
  code "$@"
fi
