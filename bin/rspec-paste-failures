#!/usr/bin/env ruby

require 'optparse'

VERSION = "1.0.0"
SCRIPT_NAME = File.basename(__FILE__)

if ARGV.include?("--version") || ARGV.include?("-v")
  puts "#{SCRIPT_NAME} #{VERSION}"
  exit 0
end

# Only require term-ansicolor for interactive mode
unless ARGV.include?("--stdin")
  begin
    gem 'term-ansicolor', '>=1.0.5'
    require 'term/ansicolor'
  rescue Exception => ex
    # Continue without color support
  end
end

options = { stdin: false }
OptionParser.new do |opts|
  opts.on("--stdin", "Read from stdin (non-interactive, exits on EOF)") do
    options[:stdin] = true
  end

  opts.on("-h", "--help") do
    puts <<~HELP
      #{SCRIPT_NAME} turns rspec failure output into a runnable rspec command.

      When there are test failures RSpec often prints out lines that look
      like the below at the end of its output:

        4992 examples, 3 failures

        Failed examples:

        rspec ./spec/bar_spec.rb:23 # failed for a reason
        rspec ./spec/baz_spec.rb:32 # failed for another reason
        rspec ./spec/foo_spec.rb:78 # failed for a third reason

      The #{SCRIPT_NAME} command will let you copy and paste the RSpec output
      and turn it into a runnable command that looks like this:

        rspec ./spec/bar_spec.rb:23 ./spec/baz_spec.rb:32 ./spec/foo_spec.rb:78

      Options:
        --stdin          Read from stdin and exit (non-interactive)
        -v, --version    Show version
        -h, --help       Show this help

    HELP
    puts opts
    exit
  end
end.parse!

def bold(str)
  "\e[1m#{str}\e[0m"
end

def output_commands(lines, use_bold: true)
  content = lines.join
  cli_args = content.scan(/rspec (.*?) #/).flatten.sort.uniq.join(' ')
  cli_args_files_only = content.scan(/rspec (.*?):/).flatten.sort.uniq.join(' ')

  if use_bold
    puts <<~STR
      #{bold('Runnable command with line numbers:')}

      #{bold('rspec')} #{bold(cli_args)}

      #{bold('Runnable command by file:')}

      #{bold('rspec')} #{bold(cli_args_files_only)}
    STR
  else
    puts "Runnable command with line numbers:"
    puts
    puts "rspec #{cli_args}"
    puts
    puts "Runnable command by file:"
    puts
    puts "rspec #{cli_args_files_only}"
  end
end

if options[:stdin]
  # Non-interactive mode: read from stdin until EOF
  lines = STDIN.readlines
  output_commands(lines, use_bold: false)
else
  # Interactive mode: read until Ctrl-C
  puts "Please paste in the failed RSpec output. Hit Ctrl-c when done to get the runnable RSpec command:"
  puts
  lines = []

  trap('INT') do
    puts
    output_commands(lines)
    exit
  end

  loop do
    lines << gets
  end
end
