#!/usr/bin/env ruby
# frozen_string_literal: true

require 'optparse'
require 'fileutils'

VERSION = "1.1.0"
SCRIPT_NAME = File.basename(__FILE__)

class AliasDirectory
  DEFAULT_RC_FILE = File.expand_path('~/.alias-directoryrc')
  INVALID_SHELL_CHARS = /[&:;\[\]|<>`$(){}!#*?\\'"]/

  def initialize(args)
    @args = args.dup
    @rc_file = DEFAULT_RC_FILE
    parse_global_options!
  end

  def run
    if @args.empty?
      show_usage
      exit 1
    end

    command = @args.first

    case command
    when 'config'
      show_config
    when 'list'
      list_aliases
    when 'create'
      if @args.length == 2
        add_alias(@args[1], Dir.pwd)
      elsif @args.length == 3
        add_alias(@args[1], @args[2])
      else
        show_usage
        exit 1
      end
    when '-h', '--help'
      show_usage
    when '-v', '--version'
      puts "#{SCRIPT_NAME} #{VERSION}"
    else
      show_usage
      exit 1
    end
  end

  private

  def parse_global_options!
    while @args.first&.start_with?('--')
      opt = @args.shift
      case opt
      when /^--rc-file=(.+)$/
        @rc_file = $1
      when '--rc-file'
        @rc_file = @args.shift
      else
        @args.unshift(opt)
        break
      end
    end
  end

  def show_usage
    puts <<~USAGE
      Usage: alias-directory [options] <command> [arguments]

      Options:
        --rc-file PATH          Use a custom RC file (default: ~/.alias-directoryrc)

      Commands:
        config                  Show configuration information
        list                    List all directory aliases (alphabetically)
        create <name> [path]    Add or update a directory alias (defaults to pwd)

      Examples:
        alias-directory config
        alias-directory list
        alias-directory create myproject ~/Code/myproject
        alias-directory create myproject                      # uses current directory
        alias-directory --rc-file=/tmp/test.rc list           # use custom RC file

      Tip: Create a shell alias for easier access:
        alias ad='alias-directory'

      Then source ~/.alias-directoryrc in your shell profile to use your directory aliases:
        source ~/.alias-directoryrc

      Once sourced, just type the alias name to jump to that directory:
        myproject    # runs: cd ~/Code/myproject
    USAGE
  end

  def show_config
    puts "RC file: #{@rc_file}"
  end

  def list_aliases
    ensure_rc_file_exists
    aliases = parse_aliases
    if aliases.empty?
      puts "No aliases defined."
    else
      aliases.keys.sort.each do |name|
        puts "#{name} -> #{aliases[name]}"
      end
    end
  end

  def add_alias(name, path)
    validate_name!(name)
    validate_path!(path)

    ensure_rc_file_exists
    aliases = parse_aliases
    aliases[name] = path
    write_aliases(aliases)

    puts "Alias '#{name}' set to: cd #{path}"
  end

  def validate_name!(name)
    if name =~ INVALID_SHELL_CHARS
      $stderr.puts "Error: Invalid alias name '#{name}'. Contains invalid shell characters."
      exit 1
    end
  end

  def validate_path!(path)
    if path =~ INVALID_SHELL_CHARS
      $stderr.puts "Error: Invalid path '#{path}'. Contains invalid shell characters."
      exit 1
    end
  end

  def ensure_rc_file_exists
    FileUtils.touch(@rc_file) unless File.exist?(@rc_file)
  end

  def parse_aliases
    return {} unless File.exist?(@rc_file)

    aliases = {}
    File.readlines(@rc_file).each do |line|
      line = line.strip
      next if line.empty? || line.start_with?('#')

      # Parse: alias name='cd /path/to/dir' (spaces escaped with backslash)
      if line =~ /^alias\s+(\S+)='cd\s+(.+)'$/
        # Unescape backslash-escaped spaces
        aliases[$1] = $2.gsub('\ ', ' ')
      end
    end
    aliases
  end

  def write_aliases(aliases)
    File.open(@rc_file, 'w') do |f|
      f.puts "# Directory aliases managed by alias-directory"
      f.puts "# Do not edit manually - changes may be overwritten"
      f.puts
      aliases.keys.sort.each do |name|
        # Escape spaces with backslashes for shell compatibility
        escaped_path = aliases[name].gsub(' ', '\ ')
        f.puts "alias #{name}='cd #{escaped_path}'"
      end
    end
  end
end

AliasDirectory.new(ARGV).run
