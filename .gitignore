# Claude Code
.claude/settings.local.json
.claude/projects/
.claude/todos.json
.claude/*.log

# Nested .claude directories (e.g., in subdirectories)
**/.claude/settings.local.json
**/.claude/projects/
**/.claude/todos.json

# Ignore generated binstubs except rspec and bundle
script/*
!script/rspec
!script/bundle

# RSpec status file
spec/.rspec_status
